<view class="reader-shell">
  <scroll-view class="chapter-strip" scroll-x="true" wx:if="{{chapters.length}}">
    <button wx:for="{{chapters}}" wx:key="0" class="chapter-item" data-page="{{item[1]}}" bindtap="jumpToChapter">{{item[0]}} · {{item[1]}}-{{item[2]}}页</button>
  </scroll-view>
  <scroll-view class="reader-scroll" scroll-y="true" scroll-into-view="{{intoView}}" enhanced="true" show-scrollbar="false" bindscroll="onScroll">
    <view wx:for="{{pages}}" wx:key="page" id="reader-page-{{item.page}}" class="reader-page" data-index="{{index}}" style="height:{{item.displayHeight}}rpx">
      <image wx:if="{{!item.failed}}" class="reader-image" src="{{item.src}}" mode="aspectFit" lazy-load="true" show-menu-by-longpress="true" data-index="{{index}}" binderror="onImageError"/>
      <button wx:else class="reader-placeholder reader-error" data-index="{{index}}" bindtap="retryImage">第 {{item.page}} 页加载失败，点击重试</button>
    </view>
  </scroll-view>
  <view class="reader-overlay"><text class="reader-counter">{{catalog.title}} · {{currentPage}} / {{catalog.pages}}</text><button class="reader-action" bindtap="addCurrentPage">记录这一页</button><button class="reader-action" bindtap="openSelection">选型单</button></view>
</view>
