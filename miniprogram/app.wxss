page { background: #f5f3ef; color: #252b28; font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "Microsoft YaHei", sans-serif; }
view, text, button, image, scroll-view { box-sizing: border-box; }
button { margin: 0; padding: 0; border-radius: 0; background: transparent; color: inherit; line-height: inherit; }
button::after { border: 0; }
.page-shell { min-height: 100vh; padding-bottom: 48rpx; }
.eyebrow { color: #a64f33; font-size: 20rpx; letter-spacing: 4rpx; }
.muted { color: #7b817c; }
.section-title { font-family: Georgia, "Songti SC", serif; font-size: 48rpx; font-weight: 400; line-height: 1.2; }
.top-brand { display: flex; align-items: center; gap: 18rpx; padding: 48rpx 40rpx 24rpx; }
.brand-mark { color: #a64f33; font-family: Georgia, serif; font-size: 32rpx; letter-spacing: 2rpx; }
.brand-name { display: block; font-family: Georgia, "Songti SC", serif; font-size: 30rpx; letter-spacing: 6rpx; }
.brand-subtitle { display: block; color: #7b817c; font-size: 18rpx; letter-spacing: 2rpx; margin-top: 4rpx; }
.hero { padding: 36rpx 40rpx 44rpx; background: #e7e3db; }
.hero-title { margin: 18rpx 0; font-family: Georgia, "Songti SC", serif; font-size: 78rpx; font-weight: 400; line-height: 1.06; }
.hero-copy { color: #636963; font-size: 26rpx; line-height: 1.8; }
.hero-link { display: flex; justify-content: space-between; align-items: center; margin-top: 34rpx; padding: 24rpx 26rpx; background: #a64f33; color: #fff; font-size: 25rpx; }
.intro-card { margin: 28rpx 40rpx 42rpx; padding: 28rpx; background: #252b28; color: #f6f1e8; }
.intro-card-title { font-family: Georgia, "Songti SC", serif; font-size: 36rpx; }
.intro-card-copy { color: #c5ccc4; font-size: 23rpx; line-height: 1.7; margin-top: 12rpx; }
.supply-head { padding: 12rpx 40rpx 20rpx; }
.supply-head .section-title { margin: 14rpx 0 8rpx; }
.supply-head .muted { font-size: 23rpx; }
.category-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rpx; margin: 0 40rpx; background: #d9d9d2; }
.category-card { min-height: 190rpx; padding: 24rpx; background: #fbfaf7; text-align: left; }
.category-card:active { background: #eee6dd; }
.category-card-index { color: #a64f33; font-family: Georgia, serif; font-size: 22rpx; }
.category-card-title { display: block; margin-top: 26rpx; font-size: 30rpx; }
.category-card-en { display: block; color: #7b817c; font-size: 16rpx; letter-spacing: 2rpx; margin-top: 8rpx; }
.category-card-intro { display: block; color: #7b817c; font-size: 19rpx; line-height: 1.5; margin-top: 16rpx; }
.bottom-note { padding: 44rpx 40rpx 10rpx; color: #7b817c; font-size: 20rpx; line-height: 1.7; }
.catalog-head { padding: 42rpx 40rpx 28rpx; }
.catalog-head .section-title { margin: 14rpx 0 10rpx; }
.catalog-head-copy { color: #7b817c; font-size: 23rpx; line-height: 1.7; }
.catalog-list { padding: 0 40rpx 42rpx; }
.catalog-card { display: flex; align-items: center; gap: 24rpx; width: 100%; padding: 28rpx 0; border-top: 1rpx solid #d9d9d2; text-align: left; }
.catalog-number { color: #a64f33; font-family: Georgia, serif; font-size: 24rpx; width: 42rpx; }
.catalog-card-body { flex: 1; }
.catalog-brand { color: #a64f33; font-size: 18rpx; letter-spacing: 2rpx; }
.catalog-title { display: block; margin-top: 9rpx; font-size: 31rpx; }
.catalog-meta { display: block; color: #7b817c; font-size: 20rpx; margin-top: 8rpx; }
.catalog-arrow { color: #a64f33; font-size: 24rpx; }
.back-link { display: inline-flex; padding: 28rpx 40rpx 0; color: #a64f33; font-size: 22rpx; }
.reader-page { position: relative; width: 100%; background: #ebe7df; }
.reader-image { display: block; width: 100%; height: auto; }
.reader-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #9b9e98; font-size: 22rpx; background: #ebe7df; }
.reader-overlay { position: fixed; left: 28rpx; right: 28rpx; bottom: 26rpx; z-index: 2; display: flex; align-items: center; justify-content: space-between; padding: 18rpx 22rpx; background: rgba(37, 43, 40, .9); color: #f6f1e8; }
.reader-counter { font-family: Georgia, serif; font-size: 24rpx; }
.reader-action { padding: 12rpx 18rpx; border: 1rpx solid #c9d0c6; color: #f6f1e8; font-size: 20rpx; }
.chapter-strip { display: flex; gap: 14rpx; padding: 22rpx 40rpx; overflow-x: scroll; white-space: nowrap; background: #fbfaf7; }
.chapter-item { flex: none; padding: 12rpx 18rpx; border: 1rpx solid #d9d9d2; color: #7b817c; font-size: 20rpx; }
.chapter-item.active { border-color: #a64f33; color: #a64f33; }
.selection-head { padding: 44rpx 40rpx 28rpx; }
.selection-head .section-title { margin: 14rpx 0 10rpx; }
.selection-empty { margin: 24rpx 40rpx; padding: 78rpx 26rpx; background: #ebe7df; color: #7b817c; text-align: center; font-size: 24rpx; line-height: 1.7; }
.selection-list { padding: 0 40rpx; }
.selection-item { display: flex; justify-content: space-between; gap: 20rpx; padding: 24rpx 0; border-top: 1rpx solid #d9d9d2; }
.selection-item-title { display: block; font-size: 28rpx; }
.selection-item-meta { display: block; color: #7b817c; font-size: 20rpx; margin-top: 8rpx; }
.selection-item-body { flex: 1; }
.selection-input { width: 100%; margin-top: 18rpx; padding: 16rpx; border: 1rpx solid #d9d9d2; background: #fbfaf7; font-size: 22rpx; }
.selection-save { display: inline-block; margin-top: 14rpx; padding: 10rpx 14rpx; border: 1rpx solid #a64f33; color: #a64f33; font-size: 20rpx; }
.selection-remove { color: #a64f33; font-size: 21rpx; }
